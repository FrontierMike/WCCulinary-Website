---
// The Christmas takeout notice, above the sticky header on every page but its
// own. Deliberately a strip and not a hero: the business is private dining and
// catering all year, and one seasonal offer should read as an announcement
// rather than as what the company now does.
//
// It comes down twice over. The build-time check below drops it out of the
// HTML at the next deploy; the inline script removes it on the visitor's own
// clock, so a site nobody rebuilds over the holidays is not still advertising
// a closed order list in January.
import { href } from '../lib/href';
import { ORDER_BY, ORDER_BY_LABEL, takingOrders } from '../data/christmas';

const path = href('christmas-turkey-dinners');
// Not on the page it points at.
const show = takingOrders() && Astro.url.pathname !== path;
---
{show && (
  <>
    <aside id="xmas-strip">
      <a href={path}>
        <span class="text">
          <strong>Gluten-free roast turkey dinners for Christmas.</strong>
          <span class="when">Ready to pick up — order by {ORDER_BY_LABEL}.</span>
        </span>
        <span class="go">See the menu<span aria-hidden="true"> →</span></span>
      </a>
    </aside>
    <script is:inline set:html={`if(new Date().toLocaleDateString('en-CA')>'${ORDER_BY}')document.getElementById('xmas-strip').remove()`}></script>
  </>
)}

<style>
  /* Accent, not red and green: the strip has to look like this site making an
     announcement, not like a different business borrowed the top of the page.
     Solid accent with dark type is the one band on the site that is not dark,
     which is what makes it read as news before anything else on the page. */
  #xmas-strip {
    background: var(--color-accent);
    color: var(--color-bg);
    line-height: 1.3;
  }
  /* Not sticky. It scrolls away and the header takes the top of the screen
     back, which is how a notice is supposed to behave. */
  #xmas-strip a {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 10px 28px;
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 14px var(--page-pad);
    color: inherit;
    text-decoration: none;
  }
  /* The global focus ring is accent, which vanishes on an accent band. */
  #xmas-strip a:focus-visible { outline: 2px solid var(--color-bg); outline-offset: -5px; }
  #xmas-strip .text { display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 14px; }
  #xmas-strip strong { font: 400 1.5rem/1.1 var(--font-serif); }
  #xmas-strip .when { font-size: 0.9375rem; font-weight: 500; }
  /* A button, dark on the band, shaped like the site's own buttons. */
  #xmas-strip .go {
    flex: none;
    padding: 10px 18px;
    border-radius: var(--radius-md);
    background: var(--color-bg);
    color: var(--color-accent-300);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    white-space: nowrap;
    transition: background .25s var(--ease), color .25s var(--ease);
  }
  #xmas-strip a:hover .go { background: var(--color-surface); color: var(--color-text); }

  /* Phones: headline, then the deadline, with the button beside them.
     Nothing is dropped — "pick up" is what stops a visitor reading this as
     another catering quote, and the deadline is what makes them tap today. */
  @media (max-width: 760px) {
    #xmas-strip a { justify-content: space-between; flex-wrap: nowrap; gap: 14px; padding: 12px var(--page-pad); }
    #xmas-strip .text { flex-direction: column; gap: 3px; min-width: 0; }
    #xmas-strip strong { font-size: 1.1875rem; }
    #xmas-strip .when { font-size: 0.8125rem; }
    #xmas-strip .go { padding: 9px 12px; font-size: 0.6875rem; letter-spacing: 0.12em; }
  }
</style>
