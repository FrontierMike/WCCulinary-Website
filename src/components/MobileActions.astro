---
// Call and quote, pinned to the bottom of a phone screen. Below 1280px the
// header folds the phone number and the Enquire button into the menu, and on a
// phone nothing else on a page is a way to get in touch until the closing CTA
// at the foot of it. Tablets get the Enquire button back in the header instead
// (SiteHeader.astro) — this bar is phones only.
//
// Base leaves it off the contact and thank-you pages, where it would point at
// the page you are already on.
import { href } from '../lib/href';

interface Props {
  /** Where "Get a quote" goes. Service pages prefill the form's Service. */
  quoteHref?: string;
}
const { quoteHref = href('contact') } = Astro.props;
---
<nav class="mobile-actions" aria-label="Contact">
  <a href="tel:+16046266527">Call</a>
  <a class="quote" href={quoteHref}>Get a quote</a>
</nav>

<style>
  .mobile-actions { display: none; }

  @media (max-width: 760px) {
    .mobile-actions {
      position: fixed;
      inset: auto 0 0 0;
      z-index: 50;
      display: grid;
      grid-template-columns: 1fr 2fr;
      gap: 10px;
      padding: 10px 16px calc(10px + env(safe-area-inset-bottom));
      background: color-mix(in srgb, var(--color-bg) 90%, transparent);
      backdrop-filter: blur(16px);
      border-top: 1px solid var(--color-divider);
    }

    /* Room at the foot of the page, so the bar never covers the footer's last
       line. :global because the rule is about <body>, not this component. */
    :global(body:has(.mobile-actions)) { padding-bottom: 68px; }
  }

  a {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    border: 1px solid var(--color-neutral-700);
    border-radius: var(--radius-md);
    font-size: 11.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-neutral-200);
  }

  .quote {
    border-color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 16%, transparent);
    color: var(--color-accent-300);
  }
</style>
