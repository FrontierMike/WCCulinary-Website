---
import { Image } from 'astro:assets';
import { img } from '../data/images';

interface Props {
  kicker?: string;
  heading: string;
  lead?: string;
  /** Design slot in src/data/images.ts. NOT named `slot` — that is reserved by
      Astro for slot assignment, and a component carrying one is silently moved
      into a named slot on its parent instead of rendering. */
  photo: string;
  alt: string;
  /** Gallery's h1 runs far larger than the interior pages'. */
  size?: 'interior' | 'gallery';
  /** Per-page, because the subject dictates it — see the About note below. */
  height?: string;
  objectPosition?: string;
  /** About's portrait is a monochrome original. Nothing else uses this. */
  grayscale?: boolean;
}

const {
  kicker,
  heading,
  lead,
  photo,
  alt,
  size = 'interior',
  height = 'min(62vh, 540px)',
  objectPosition = 'center 46%',
  grayscale = false,
} = Astro.props;
---
<section class:list={['hero', size]} style={`min-height:${height}`}>
  <Image
    src={img(photo)}
    alt={alt}
    widths={[900, 1400, 1900]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    style={`object-position:${objectPosition}${grayscale ? ';filter:grayscale(1)' : ''}`}
  />
  {/* Both scrims, always. The Gallery hero shipped with only the bottom-up one
      and its kicker failed contrast over the bright part of the photo. */}
  <div class="scrim-lr"></div>
  <div class="scrim-bt"></div>
  <div class="content hero-rise">
    {kicker && <p class="kicker">{kicker}</p>}
    <h1>{heading}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
  }

  .hero :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .content {
    position: relative;
    width: 100%;
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 150px var(--page-pad) 68px;
  }

  h1 {
    margin: 20px 0 24px;
    max-width: 24ch;
    font-size: clamp(32px, 4.4vw, 58px);
    line-height: 1.04;
    letter-spacing: -0.012em;
  }

  .kicker { font-size: 11.5px; }
  .lead { font-size: 17.5px; line-height: 1.64; max-width: 56ch; }

  .gallery h1 {
    max-width: 18ch;
    font-size: clamp(48px, 8vw, 110px);
    line-height: 0.98;
    letter-spacing: 0.01em;
  }
</style>
