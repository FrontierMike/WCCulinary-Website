---
import { Image } from 'astro:assets';
import logo from '../assets/images/wccc-logo-circle.png';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (p: string) => `${base}/${p}`.replace(/\/+/g, '/');

const columns = [
  {
    label: 'Services',
    links: [
      ['Private dining', 'private-dining'],
      ['Weddings', 'weddings'],
      ['Corporate', 'corporate'],
      ['Celebrations', 'celebrations'],
      ['Wine pairing dinners', 'wine-dinners'],
    ],
  },
  {
    label: 'Explore',
    links: [
      ['All services', 'services'],
      ['Example menus', 'menus'],
      ['Gallery', 'gallery'],
      ['Reviews', 'reviews'],
      ['About Jan', 'about'],
    ],
  },
  {
    label: 'Gluten-free',
    links: [
      ['Gluten-free catering', 'gluten-free-catering'],
      ['Gluten-free consulting', 'gluten-free-consulting'],
    ],
  },
];
---
<footer>
  <div class="inner">
    {/* Brand row is deliberately NOT a grid sibling of the link columns — as a
        5th item in the auto-fit grid it stranded a dead cell at laptop widths. */}
    <div class="brand">
      <Image src={logo} alt="West Coast Culinary Creations — chef designed, chef made" width={318} height={318} />
      <p>
        Restaurant cooking, in your venue or your kitchen. A Red Seal chef and a small
        number of events a year — South Surrey, White Rock and the Lower Mainland.
      </p>
    </div>

    <div class="links">
      {columns.map((col) => (
        <div class="col">
          <p class="label">{col.label}</p>
          {col.links.map(([label, path]) => <a href={href(path)}>{label}</a>)}
        </div>
      ))}
      <div class="col">
        <p class="label">Contact</p>
        <a href={href('contact')}>Request a quote</a>
        <span>[Phone — to add]</span>
        <span>[Instagram — to add]</span>
      </div>
    </div>

    <div class="meta">
      <p>© {new Date().getFullYear()} West Coast Culinary Creations. Chef Janet Wait, Red Seal.</p>
      <p>South Surrey · White Rock · Lower Mainland</p>
    </div>
  </div>
</footer>

<style>
  footer { border-top: 1px solid var(--color-divider); background: var(--color-bg); }

  .inner {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 72px var(--page-pad) 40px;
    display: flex;
    flex-direction: column;
    gap: 60px;
  }

  .brand { display: flex; flex-wrap: wrap; align-items: center; gap: 38px; }
  .brand :global(img) { flex: none; width: 318px; height: 318px; }
  .brand p {
    max-width: 44ch;
    font-size: 14.5px;
    line-height: 1.65;
    color: var(--color-neutral-400);
  }

  .links { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 32px; }

  .col { display: flex; flex-direction: column; gap: 11px; }

  .label {
    margin-bottom: 4px;
    font-size: 10px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-neutral-500);
  }

  .col a { font-size: 14px; color: var(--color-neutral-300); transition: color .25s var(--ease); }
  .col a:hover { color: var(--color-accent-300); }
  .col span { font-size: 14px; color: var(--color-neutral-500); }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    justify-content: space-between;
    border-top: 1px solid var(--color-divider);
    padding-top: 24px;
  }
  .meta p { font-size: 12px; color: var(--color-neutral-500); }

  @media (max-width: 560px) {
    .brand :global(img) { width: 200px; height: 200px; }
  }
</style>
