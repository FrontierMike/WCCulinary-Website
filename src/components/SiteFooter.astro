---
import { href } from '../lib/href';
import { eventServiceLinks, glutenFreeLinks } from '../lib/nav';
import { Image } from 'astro:assets';
import logo from '../assets/images/wccc-logo-circle.png';
import { SERVICE_AREA } from '../lib/seo';

// Two uses of a no-break space, so this list wraps tidily at every width:
// inside a name, so "West Vancouver" never splits across two lines; and before
// each separator, so a wrap never strands a "· " at the start of one. What is
// left is an ordinary space after each separator — the only place a break can
// land, which is exactly where it should.
const areas = SERVICE_AREA.map((a) => a.replace(/ /g, '\u00A0')).join('\u00A0· ');

const columns: { label: string; links: [string, string][] }[] = [
  { label: 'Services', links: eventServiceLinks },
  {
    label: 'Explore',
    links: [
      ['Gallery', 'gallery'],
      ['Reviews', 'reviews'],
      ['About Jan', 'about'],
    ],
  },
  { label: 'Gluten-free', links: glutenFreeLinks },
];
---
<footer>
  <div class="inner">
    {/* Brand row is deliberately NOT a grid sibling of the link columns — as a
        5th item in the auto-fit grid it stranded a dead cell at laptop widths. */}
    <div class="brand">
      <Image src={logo} alt="West Coast Culinary Creations — chef designed, chef made" width={318} height={318} />
      <p>
        Restaurant cooking, in your venue or your kitchen. A Red Seal chef and a small
        number of events a year — South Surrey, White Rock and across the Lower Mainland.
      </p>
    </div>

    <div class="links">
      {columns.map((col) => (
        <div class="col">
          <p class="label">{col.label}</p>
          {col.links.map(([label, path]) => <a href={href(path)}>{label}</a>)}
        </div>
      ))}
      <div class="col">
        <p class="label">Contact</p>
        <a href={href('contact')}>Request a quote</a>
        <a href="tel:+16046266527">604 626 6527</a>
        <a href="https://www.instagram.com/west_coast_culinary_creations/" target="_blank" rel="noopener">Instagram</a>
        <a href="https://www.facebook.com/profile.php?id=61556583523585" target="_blank" rel="noopener">Facebook</a>
        <a href="https://maps.google.com/?cid=11488159639631320576" target="_blank" rel="noopener">Google Business Profile</a>
      </div>
    </div>

    <div class="meta">
      <p>© {new Date().getFullYear()} West Coast Culinary Creations. Chef Janet Wait, Red Seal.</p>
      {/* Named one by one rather than as "the Lower Mainland", because this
          line sits on every page and is the site's broadest statement of where
          the work happens. Straight from SERVICE_AREA, which is also what the
          areaServed markup publishes — one list, so they cannot disagree. */}
      <p class="areas">{areas}</p>
    </div>
  </div>
</footer>

<style>
  footer { border-top: 1px solid var(--color-divider); background: var(--color-bg); }

  .inner {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 72px var(--page-pad) 40px;
    display: flex;
    flex-direction: column;
    gap: 60px;
  }

  .brand { display: flex; flex-wrap: wrap; align-items: center; gap: 38px; }
  .brand :global(img) { flex: none; width: 318px; height: 318px; }
  .brand p {
    max-width: 44ch;
    font-size: 0.9063rem;
    line-height: 1.65;
    color: var(--color-neutral-400);
  }

  .links { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 32px; }

  .col { display: flex; flex-direction: column; gap: 11px; }

  .label {
    margin-bottom: 4px;
    font-size: 0.625rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-neutral-500);
  }

  .col a { font-size: 0.875rem; color: var(--color-neutral-300); transition: color .25s var(--ease); }
  .col a:hover { color: var(--color-accent-300); }
  .col span { font-size: 0.875rem; color: var(--color-neutral-500); }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    justify-content: space-between;
    border-top: 1px solid var(--color-divider);
    padding-top: 24px;
  }
  .meta p { font-size: 0.75rem; color: var(--color-neutral-500); }

  /* .meta is a two-item space-between row, and the area list will not sit
     opposite the copyright line. width:100% takes a row of its own — not
     flex-basis, which a max-width would then cap, leaving it back on the
     first row. Second in the DOM, so it lands underneath. */
  .areas {
    width: 100%;
    line-height: 1.85;
    color: var(--color-neutral-600);
  }

  @media (max-width: 560px) {
    .brand :global(img) { width: 200px; height: 200px; }
  }
</style>
