---
// Sticky header. `active` is a page key or a service slug; it highlights the
// matching nav item, and any service slug also lights up the Services parent.
import { href } from '../lib/href';
import { serviceLinks, serviceSlugs } from '../lib/nav';

interface Props { active?: string }
const { active = '' } = Astro.props;

// Top level is four items. Everything Jan sells hangs off Services, so the
// header names destinations rather than pointing at an index page.
const nav = [
  { key: 'gallery', label: 'Gallery', path: 'gallery' },
  { key: 'reviews', label: 'Reviews', path: 'reviews' },
  { key: 'about',   label: 'About',   path: 'about' },
];

const inServices = serviceSlugs.has(active);
---
<header>
  <div class="inner">
    <a class="wordmark" href={href('')}>
      <span class="name">West Coast Culinary Creations</span>
      <span class="tagline">Chef designed, chef made</span>
    </a>

    <nav class="nav-desktop">
      {/* No JS: the submenu opens on hover, and on focus-within for keyboard
          and click — clicking the button focuses it, tabbing out or clicking
          away blurs it, so it light-dismisses on its own. */}
      <div class="has-sub">
        <button type="button" class:list={['nav-link', 'nav-parent', { on: inServices }]} aria-haspopup="true">
          Services<span class="chev" aria-hidden="true"></span>
        </button>
        <div class="sub">
          <div class="sub-inner" role="group" aria-label="Services">
            {serviceLinks.map(([label, path]) => (
              <a href={href(path)} class:list={['sub-link', { on: active === path }]}>{label}</a>
            ))}
          </div>
        </div>
      </div>

      {nav.map((item) => (
        <a href={href(item.path)} class:list={['nav-link', { on: active === item.key }]}>{item.label}</a>
      ))}
      <a href="tel:+16046266527" class="nav-link phone">604 626 6527</a>
      <a href={href('contact')} class="enquire">Enquire</a>
    </nav>

    {/* Below ~1280px the 40px wordmark leaves no room for a nav row, so it
        collapses into this menu. <details> gives us the toggle with no JS.
        The services are listed inline here — one panel, no second toggle. */}
    <details class="nav-mobile">
      <summary aria-label="Menu"><span></span><span></span><span></span></summary>
      <div class="panel">
        <p class="group-label">Services</p>
        {serviceLinks.map(([label, path]) => (
          <a href={href(path)} class:list={['nav-link', 'indent', { on: active === path }]}>{label}</a>
        ))}
        <hr />
        {nav.map((item) => (
          <a href={href(item.path)} class:list={['nav-link', { on: active === item.key }]}>{item.label}</a>
        ))}
        <a href="tel:+16046266527" class="nav-link phone">604 626 6527</a>
        <a href={href('contact')} class="enquire">Enquire</a>
      </div>
    </details>
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 60;
    background: color-mix(in srgb, var(--color-bg) 82%, transparent);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--color-divider);
  }

  .inner {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 13px 28px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .wordmark { display: flex; flex-direction: column; gap: 3px; color: var(--color-text); }

  .name {
    font-family: var(--font-serif);
    /* 40px is the client's request; it only fits above the breakpoint, so it
       scales down on narrow screens rather than overflowing. */
    font-size: clamp(23px, 5.2vw, 40px);
    letter-spacing: 0.005em;
    line-height: 1.06;
    white-space: nowrap;
  }

  .tagline {
    font-size: 0.6875rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-neutral-500);
  }

  .nav-desktop { display: flex; align-items: center; gap: 17px; }

  .nav-link {
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-neutral-400);
    padding: 4px 0;
    transition: color .25s var(--ease);
  }
  .nav-link:hover { color: var(--color-accent-300); }
  .nav-link.on { color: var(--color-accent-300); }

  /* Already the smallest text on the site, so it does not follow the root down
     the mobile type scale — 0.625rem of a 16.524px root is barely 10px. */
  @media (max-width: 640px) { .nav-link { font-size: 11.5px; } }

  .phone { white-space: nowrap; color: var(--color-neutral-200); }

  .enquire {
    padding: 10px 17px;
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-md);
    color: var(--color-accent-300);
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    transition: background .25s var(--ease);
  }
  .enquire:hover { background: color-mix(in srgb, var(--color-accent) 16%, transparent); }

  /* --- Services submenu (desktop) --- */
  .has-sub { position: relative; }

  .nav-parent {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: none;
    border: 0;
    font: inherit;
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .chev {
    width: 5px;
    height: 5px;
    border-right: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    transform: translateY(-1px) rotate(45deg);
    transition: transform .25s var(--ease);
  }
  .has-sub:hover .chev,
  .has-sub:focus-within .chev { transform: translateY(1px) rotate(225deg); }

  .sub {
    position: absolute;
    left: 50%;
    top: 100%;
    translate: -50% 0;
    /* Transparent padding, not a gap — it bridges the button to the panel so
       the pointer never crosses dead space and closes the menu. */
    padding-top: 14px;
    opacity: 0;
    visibility: hidden;
    transition: opacity .2s var(--ease), visibility .2s var(--ease);
  }
  .has-sub:hover .sub,
  .has-sub:focus-within .sub { opacity: 1; visibility: visible; }

  .sub-inner {
    display: flex;
    flex-direction: column;
    gap: 15px;
    min-width: 216px;
    padding: 20px 22px;
    background: var(--color-bg);
    border: 1px solid var(--color-divider);
    border-radius: var(--radius-md);
  }

  .sub-link {
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--color-neutral-400);
    transition: color .25s var(--ease);
  }
  .sub-link:hover { color: var(--color-accent-300); }
  .sub-link.on { color: var(--color-accent-300); }

  /* --- Mobile menu --- */
  .nav-mobile { display: none; position: relative; }

  .nav-mobile summary {
    list-style: none;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    width: 42px;
    height: 42px;
    padding: 0 10px;
    border: 1px solid var(--color-neutral-700);
    border-radius: var(--radius-md);
    cursor: pointer;
  }
  .nav-mobile summary::-webkit-details-marker { display: none; }
  .nav-mobile summary span {
    height: 1.5px;
    background: var(--color-accent-300);
    transition: opacity .28s ease;
  }
  .nav-mobile[open] summary span:nth-child(2) { opacity: 0; }

  .panel {
    position: absolute;
    right: 0;
    top: calc(100% + 12px);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
    /* Sized to the longest service name rather than a magic number — the
       services are listed in here now, and a wrapped label reads as two
       entries. Capped so it cannot push the page sideways. */
    width: max-content;
    min-width: 210px;
    max-width: calc(100vw - 32px);
    padding: 22px 24px;
    background: var(--color-bg);
    border: 1px solid var(--color-divider);
    border-radius: var(--radius-md);
    /* Thirteen rows now the services are listed inline — scroll rather than
       run off the bottom on a short phone in landscape. */
    max-height: calc(100vh - 90px);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .panel .group-label {
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-neutral-500);
  }
  @media (max-width: 640px) { .panel .group-label { font-size: 11.5px; } }

  .panel .indent { padding-left: 14px; }

  .panel hr {
    width: 100%;
    height: 1px;
    border: 0;
    background: var(--color-divider);
    margin: 2px 0;
  }

  /* Raised from 1050 when the phone number joined the row. */
  @media (max-width: 1279.98px) {
    .nav-desktop { display: none; }
    .nav-mobile { display: block; }
  }
</style>
