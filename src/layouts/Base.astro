---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title?: string;
  description?: string;
  active?: string;
}

const {
  title = 'Private chef & catering — White Rock & South Surrey | West Coast Culinary Creations',
  description = 'Restaurant cooking in your venue or your kitchen. Red Seal chef Janet Wait caters weddings, private dinners and corporate events in South Surrey, White Rock and the Lower Mainland.',
  active = '',
} = Astro.props;

// Absolute URLs for canonical/social tags — Astro.site is set in astro.config.mjs.
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('og.jpg', Astro.site);

// Cloudflare Web Analytics. Renders nothing until the token is set as a
// PUBLIC_CF_BEACON_TOKEN build variable (see README).
const beaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN;

// Structured data: the same facts the pages state in prose, in the shape
// Google reads. Only verifiable claims belong here — no hours, no price
// range, no ratings until they are real.
const businessJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': 'https://wcculinary.com/#business',
  name: 'West Coast Culinary Creations',
  description,
  url: 'https://wcculinary.com',
  telephone: '+1-604-626-6527',
  email: 'jan@wcculinary.com',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'White Rock',
    addressRegion: 'BC',
    addressCountry: 'CA',
  },
  areaServed: ['South Surrey', 'White Rock', 'Lower Mainland', 'Metro Vancouver'],
  founder: {
    '@type': 'Person',
    name: 'Janet Wait',
    jobTitle: 'Red Seal Chef',
  },
  sameAs: [
    'https://www.instagram.com/west_coast_culinary_creations/',
    'https://www.facebook.com/profile.php?id=61556583523585',
    'https://maps.google.com/?cid=11488159639631320576',
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <script type="application/ld+json" set:html={JSON.stringify(businessJsonLd)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Chef Janet Wait finishing a line of plated courses during service" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#1a1a1a" />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500&family=Instrument+Serif:ital@0;1&display=swap"
    />
  </head>
  <body>
    <SiteHeader active={active} />
    <slot />
    <SiteFooter />
    <script>import '../scripts/reveal.js';</script>
    {beaconToken && (
      <script
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: beaconToken })}
      />
    )}
  </body>
</html>
