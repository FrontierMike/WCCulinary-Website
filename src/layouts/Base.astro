---
// Self-hosted fonts, the same four faces the Google Fonts link used to load.
// Served from this origin, they skip the extra DNS lookup and TLS handshake
// a third-party stylesheet costs before any text can paint.
import '@fontsource/instrument-sans/400.css';
import '@fontsource/instrument-sans/500.css';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '../styles/global.css';
// Every hero headline is set in this one; preloading it lets the h1 paint in
// the real face instead of swapping from Georgia after load.
import serifLatin from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MobileActions from '../components/MobileActions.astro';
import { getImage } from 'astro:assets';
import { img } from '../data/images';
import { graph, businessNode, chefNode, websiteNode, breadcrumbNode } from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  active?: string;
  /** Keeps a page out of search results. Used by the thank-you pages, which
   *  would otherwise get indexed and have crawler hits inflate the enquiry
   *  count they exist to measure. */
  noindex?: boolean;
  /** Crumb trail below Home, as [label, path] pairs. Renders as BreadcrumbList
   *  JSON-LD only — Google reads it there and shows it in place of the raw URL
   *  in results, so the page needs no visible breadcrumb bar. */
  breadcrumbs?: [string, string][];
  /** Extra JSON-LD nodes for this page — a Service, an FAQPage — merged into
   *  the one graph below rather than emitted as a second detached script. */
  schema?: object[];
  /** Design slot in src/data/images.ts, rendered at 1200x630 for social cards.
   *  Falls back to the site-wide og.jpg. */
  ogImage?: string;
  /** Alt text for that card. Required whenever ogImage is set — the default
   *  describes og.jpg and would be a lie over any other photo. */
  ogImageAlt?: string;
  /** The phone-only Call / Get a quote bar. Off on the contact and thank-you
   *  pages, where it would link to the page you are on. */
  actionBar?: boolean;
  /** Where that bar's "Get a quote" goes, when not the plain contact form. */
  quoteHref?: string;
}

const {
  title = 'Private chef & catering in White Rock & South Surrey',
  description = 'Red Seal chef Janet Wait cooks private dinners, weddings and corporate events in your home or venue. White Rock, South Surrey, Surrey, Langley and Vancouver.',
  active = '',
  noindex = false,
  breadcrumbs,
  schema = [],
  ogImage: ogSlot,
  ogImageAlt = 'Chef Janet Wait finishing a line of plated courses during service',
  actionBar = true,
  quoteHref,
} = Astro.props;

// Absolute URLs for canonical/social tags — Astro.site is set in astro.config.mjs.
const canonical = new URL(Astro.url.pathname, Astro.site);

// Per-page social card, cropped to the 1.91:1 box every platform expects. A
// page that names no slot keeps the site-wide og.jpg.
const og = ogSlot
  ? await getImage({ src: img(ogSlot), width: 1200, height: 630, format: 'jpg' })
  : null;
const ogImage = new URL(og ? og.src : 'og.jpg', Astro.site);

// Structured data: the same facts the pages state in prose, in the shape
// Google reads. The site's nodes go out as one @graph, so a page's Service and
// breadcrumbs resolve their @id references to the business in a single parse
// instead of repeating it. (FAQ.astro adds its own FAQPage script — it is a
// component and cannot reach these props. Several JSON-LD blocks per page is
// valid and Google merges them.) Only verifiable claims belong here — no
// hours, no price range, no ratings until they are real. See src/lib/seo.ts.
const jsonLd = graph([
  businessNode(description),
  chefNode(),
  websiteNode(),
  ...(breadcrumbs ? [breadcrumbNode(breadcrumbs)] : []),
  ...schema,
]);
---
<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#1a1a1a" />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <link rel="preload" href={serifLatin} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <SiteHeader active={active} />
    <slot />
    <SiteFooter />
    {actionBar && <MobileActions quoteHref={quoteHref} />}
    <script>
      import '../scripts/reveal.js';
      import { capture } from '../scripts/attribution.js';
      capture();
    </script>
  </body>
</html>
