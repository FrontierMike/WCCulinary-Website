---
// One route for every service page — they share a shape, so the differences
// live in src/data/services.ts as content.
//
// Static routes (about.astro, gallery.astro, …) win over this dynamic one, so
// this only ever matches the slugs returned below.
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ServiceSections from '../components/ServiceSections.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';
import { services, type Service } from '../data/services';
import { serviceNode } from '../lib/seo';

export function getStaticPaths() {
  return services.map((service) => ({
    params: { service: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props as { service: Service };

// The page's own node: this service, offered by the business, across the whole
// service area. Without it a service page is just a page that mentions
// catering — the offering itself is never named.
const schema = [
  serviceNode({
    name: service.serviceName ?? service.title,
    description: service.summary,
    path: `/${service.slug}`,
  }),
];
---
<Base
  active={service.slug}
  title={service.seo.title}
  description={service.seo.description}
  breadcrumbs={[[service.title, `/${service.slug}`]]}
  schema={schema}
  ogImage={service.imageSlot}
  ogImageAlt={service.imageAlt}
>
  <PageHero
    kicker={service.hero.kicker}
    heading={service.hero.heading}
    lead={service.hero.lead}
    photo={service.imageSlot}
    alt={service.imageAlt}
  />

  <ServiceSections sections={service.sections} />

  <FAQ variant={service.faqVariant} />

  <CTA heading={service.cta.heading} body={service.cta.body} service={service.title} />
</Base>
