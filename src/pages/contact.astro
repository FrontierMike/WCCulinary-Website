---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { Image } from 'astro:assets';
import { enquiryOptions, heardFrom } from '../data/services';
import { img } from '../data/images';
import { href } from '../lib/href';
import { bookingFrom } from '../scripts/availability.js';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Service type can be prefilled from a service page: /contact?service=Weddings
// The label→slug map rides on the form as a data attribute rather than
// define:vars, which would force the script inline and break its imports.
const serviceSlugs = Object.fromEntries(enquiryOptions);

// "Not sure yet" leads, so an untouched form does not invent a budget.
const budgets = [
  'Not sure yet',
  'Under $1,500',
  '$1,500 – $3,000',
  '$3,000 – $6,000',
  '$6,000 – $10,000',
  'Over $10,000',
];
---
<Base
  actionBar={false}
  title="Request a catering quote — White Rock to Vancouver"
  description="Tell Chef Janet Wait about your event anywhere in the Lower Mainland. Every enquiry is answered personally, with a written quote before anything is booked."
  breadcrumbs={[['Enquire', '/contact']]}
  ogImage="gal-torte"
  ogImageAlt="A chocolate torte finished with cream"
>
  <PageHero
    kicker="Enquiries"
    heading="Tell me about your event."
    lead="I answer my own enquiries. The more you can tell me about the date, the number of people and roughly what you had in mind, the more useful my first reply will be."
    photo="gal-torte"
    alt="A chocolate torte finished with cream"
    height="min(58vh, 500px)"
  />

  <section class="wrap form-section">
    <div class="layout">
    <form id="contact-form" novalidate data-slugs={JSON.stringify(serviceSlugs)} data-base={base}>
      <div class="grid">
        <label>
          <span>Name <i>*</i></span>
          <input name="name" type="text" required autocomplete="name" />
        </label>

        <label>
          <span>Email <i>*</i></span>
          <input name="email" type="email" inputmode="email" autocapitalize="off" required autocomplete="email" />
        </label>

        <label>
          <span>Phone</span>
          <input name="phone" type="tel" inputmode="tel" autocomplete="tel" />
        </label>

        {/* The hint is outside the <label> so it is not read out as part of the
            field's name; aria-describedby ties it back. The script below swaps
            its text when the chosen date falls inside the booked window. */}
        <div class="field">
          <label>
            <span>Event date</span>
            <input name="event-date" type="date" aria-describedby="date-hint" />
          </label>
          <p class="hint" id="date-hint" aria-live="polite">
            I am usually booked two months ahead. Dates from
            <span data-booking-from>{bookingFrom()}</span> onward have the best chance.
          </p>
        </div>

        <label>
          <span>Guests</span>
          <input name="guests" type="number" min="1" inputmode="numeric" placeholder="Roughly how many" />
        </label>

        <label>
          <span>Venue or location</span>
          <input name="venue" type="text" placeholder="Your home, a venue, or undecided" />
        </label>

        <label>
          <span>Service</span>
          <select name="service">
            {enquiryOptions.map(([label]) => <option value={label}>{label}</option>)}
          </select>
        </label>

        <label>
          <span>Budget</span>
          <select name="budget">
            {budgets.map((b) => <option value={b}>{b}</option>)}
          </select>
        </label>
      </div>

      <label class="full">
        <span>How did you hear about me?</span>
        <select name="heard-from">
          <option value="">Please choose</option>
          {heardFrom.map((h) => <option value={h}>{h}</option>)}
        </select>
      </label>

      <label class="full">
        <span>What are you planning? <i>*</i></span>
        <textarea name="message" rows="6" required
          placeholder="The occasion, the kind of food you had in mind, anything your guests can't eat."></textarea>
      </label>

      {/* Honeypot: hidden from users, bots fill it. Checked in worker/index.js. */}
      <input class="hp" name="company-website" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" />

      <div class="actions">
        <button class="btn btn-primary" type="submit">Send enquiry</button>
        <p id="contact-status" role="status" aria-live="polite"></p>
      </div>
      <p class="reassure">No obligation. Nothing is booked until you approve a written quote.</p>
    </form>

    {/* What a visitor weighs while filling the form in: what happens after
        they press Send, and whether anyone like them was happy. Beside the
        form on a wide screen, after it on a phone, so the form stays first. */}
    <aside class="next">
      <p class="kicker">What happens next</p>
      <ol>
        <li><span>01</span>I reply myself, within one business day.</li>
        <li><span>02</span>We talk it through — what you like, who is coming, and what they cannot eat.</li>
        <li><span>03</span>You get a written quote. Nothing is booked until you approve it.</li>
      </ol>

      <figure>
        <blockquote>
          We are incredibly grateful for the care, effort and thoughtfulness you
          showed. The food was delicious.
        </blockquote>
        <figcaption><a href={href('reviews')}>School parent Christmas party · E &amp; S →</a></figcaption>
      </figure>

      <div class="chef">
        <Image src={img('jan-whites')} alt="Chef Janet Wait in her chef's whites" widths={[120, 240]} sizes="64px" loading="lazy" />
        <p>Chef Janet Wait<br /><span>Red Seal · twelve years at Jan's on the Beach</span></p>
      </div>

      <p class="direct">
        Prefer to talk? Call <a href="tel:+16046266527">604 626 6527</a> or email
        <a href="mailto:jan@wcculinary.com">jan@wcculinary.com</a>.
      </p>
    </aside>
    </div>
  </section>
</Base>

<script>
  import { attribution } from '../scripts/attribution.js';
  import { firstOpenDate, bookingFrom } from '../scripts/availability.js';

  const form = document.getElementById('contact-form') as HTMLFormElement;
  const status = document.getElementById('contact-status') as HTMLParagraphElement;
  const button = form.querySelector('button[type="submit"]') as HTMLButtonElement;

  const slugs: Record<string, string> = JSON.parse(form.dataset.slugs || '{}');
  const base = form.dataset.base || '';

  // Prefill the service when a service page links here with ?service=…
  const wanted = new URLSearchParams(location.search).get('service');
  if (wanted) {
    const select = form.elements.namedItem('service') as HTMLSelectElement | null;
    const match = select && [...select.options].find((o) => o.value.toLowerCase() === wanted.toLowerCase());
    if (select && match) select.value = match.value;
  }

  // A date inside the booked window is not refused — cancellations happen and
  // a weekday lunch can sometimes be fitted in — but the visitor is told before
  // they send it, and asked for a second date, which saves a round of email.
  const dateInput = form.elements.namedItem('event-date') as HTMLInputElement;
  const dateHint = document.getElementById('date-hint') as HTMLParagraphElement;
  const usualHint = `I am usually booked two months ahead. Dates from ${bookingFrom()} onward have the best chance.`;
  dateInput.addEventListener('change', () => {
    // Parsed as local midnight; `new Date('2027-01-10')` alone would be UTC
    // and land on the 9th in BC.
    const picked = dateInput.value ? new Date(`${dateInput.value}T00:00`) : null;
    const soon = !!picked && picked < firstOpenDate();
    dateHint.classList.toggle('soon', soon);
    dateHint.textContent = soon
      ? `That date is inside the two months I am usually booked. Send it anyway — dates do open up — and if you can, add a second date from ${bookingFrom()} onward in your message.`
      : usualHint;
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    button.disabled = true;
    status.textContent = 'Sending…';
    status.className = '';

    try {
      // Relative, so this works at the site root AND under a base path.
      const res = await fetch('api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          ...Object.fromEntries(new FormData(form)),
          ...attribution(),
        }),
      });
      const data = await res.json();
      if (data.ok) {
        const service = (form.elements.namedItem('service') as HTMLSelectElement).value;
        // replace, not assign: the form drops out of history, so Back returns
        // to the page they came from instead of a filled form they could
        // resubmit — which would double both the enquiry and the conversion.
        location.replace(`${base}/contact/thank-you/${slugs[service] || 'not-sure'}`);
      } else {
        status.textContent = data.error || 'Something went wrong. Please try again.';
        status.className = 'err';
        button.disabled = false;
      }
    } catch {
      status.textContent = 'Something went wrong. Please try again.';
      status.className = 'err';
      button.disabled = false;
    }
  });
</script>

<style>
  /* padding-block, not the shorthand: this element is also .wrap, and a
     shorthand with a 0 inline value wiped out the page gutter — on a phone the
     fields ran edge to edge. */
  .form-section { padding-block: calc(96px * var(--section-gap)) calc(120px * var(--section-gap)); }

  form { max-width: 780px; }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 780px) minmax(260px, 340px);
    gap: 72px;
    align-items: start;
  }
  @media (max-width: 1000px) {
    .layout { grid-template-columns: minmax(0, 1fr); gap: 56px; }
  }

  .reassure { margin-top: 16px; font-size: 0.8125rem; color: var(--color-neutral-500); }

  .next {
    display: grid;
    gap: 30px;
    padding-top: 26px;
    border-top: 1px solid var(--color-divider);
  }
  .next ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
  .next li {
    display: grid;
    grid-template-columns: 28px 1fr;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--color-neutral-300);
  }
  .next li span { font-size: 0.6875rem; letter-spacing: 0.12em; color: var(--color-accent-300); padding-top: 4px; }

  figure { margin: 0; display: grid; gap: 10px; }
  blockquote {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.0625rem;
    line-height: 1.48;
    color: var(--color-neutral-200);
  }
  figcaption a { font-size: 0.7813rem; color: var(--color-neutral-500); }
  figcaption a:hover { color: var(--color-accent-300); }

  .chef { display: flex; align-items: center; gap: 14px; }
  .chef :global(img) { width: 64px; height: 64px; object-fit: cover; object-position: center 20%; border-radius: 50%; }
  .chef p { font-size: 0.875rem; line-height: 1.5; color: var(--color-neutral-200); }
  .chef p span { font-size: 0.8125rem; color: var(--color-neutral-500); }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 26px 32px;
  }

  label { display: grid; gap: 9px; }
  label.full { margin-top: 26px; }

  label span {
    font-size: 0.625rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-neutral-500);
  }
  label i { color: var(--color-accent-300); font-style: normal; }

  input, select, textarea {
    width: 100%;
    background: var(--color-surface);
    border: 1px solid var(--color-divider);
    border-radius: var(--radius-md);
    padding: 13px 15px;
    color: var(--color-text);
    font-family: inherit;
    font-size: 0.9375rem;
  }
  textarea { resize: vertical; }
  input::placeholder, textarea::placeholder { color: var(--color-neutral-600); }
  input:focus, select:focus, textarea:focus { border-color: var(--color-accent); outline: none; }

  /* Native date/number controls render a dark-on-dark glyph otherwise. */
  input[type='date'] { color-scheme: dark; }

  /* iOS Safari zooms the whole page when a focused control's text is under
     16px, and does not zoom back out. 0.9375rem lands at 15.5px on a phone. */
  @media (max-width: 640px) {
    input, select, textarea { font-size: 16px; min-height: 50px; }
    .actions .btn { width: 100%; justify-content: center; }
  }

  /* --- Date field and its availability hint --- */
  .field { display: grid; gap: 9px; align-content: start; }
  .hint { font-size: 0.8125rem; line-height: 1.5; color: var(--color-neutral-400); }
  .hint.soon { color: var(--color-accent-300); }

  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; }

  .direct { font-size: 0.875rem; color: var(--color-neutral-400); }
  .direct a { color: var(--color-accent-300); border-bottom: 1px solid var(--color-accent-700); }

  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 24px; margin-top: 38px; }

  #contact-status { font-size: 0.875rem; color: var(--color-neutral-400); }
  #contact-status.ok { color: var(--color-accent-300); }
  #contact-status.err { color: #e2a0a0; }
</style>
