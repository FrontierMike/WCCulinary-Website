---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { enquiryOptions, heardFrom } from '../data/services';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Service type can be prefilled from a service page: /contact?service=Weddings
// The label→slug map rides on the form as a data attribute rather than
// define:vars, which would force the script inline and break its imports.
const serviceSlugs = Object.fromEntries(enquiryOptions);

// "Not sure yet" leads, so an untouched form does not invent a budget.
const budgets = [
  'Not sure yet',
  'Under $1,500',
  '$1,500 – $3,000',
  '$3,000 – $6,000',
  '$6,000 – $10,000',
  'Over $10,000',
];
---
<Base
  title="Enquire — West Coast Culinary Creations"
  description="Tell Chef Janet Wait about your event. Every enquiry is answered personally, with a written quote before anything is booked."
>
  <PageHero
    kicker="Enquiries"
    heading="Tell me about your event."
    lead="I answer my own enquiries. The more you can tell me about the date, the number of people and roughly what you had in mind, the more useful my first reply will be."
    photo="gal-torte"
    alt="A chocolate torte finished with cream"
    height="min(58vh, 500px)"
  />

  <section class="wrap form-section">
    <form id="contact-form" novalidate data-slugs={JSON.stringify(serviceSlugs)} data-base={base}>
      <div class="grid">
        <label>
          <span>Name <i>*</i></span>
          <input name="name" type="text" required autocomplete="name" />
        </label>

        <label>
          <span>Email <i>*</i></span>
          <input name="email" type="email" required autocomplete="email" />
        </label>

        <label>
          <span>Phone</span>
          <input name="phone" type="tel" autocomplete="tel" />
        </label>

        <label>
          <span>Event date</span>
          <input name="event-date" type="date" />
        </label>

        <label>
          <span>Guests</span>
          <input name="guests" type="number" min="1" inputmode="numeric" placeholder="Roughly how many" />
        </label>

        <label>
          <span>Venue or location</span>
          <input name="venue" type="text" placeholder="Your home, a venue, or undecided" />
        </label>

        <label>
          <span>Service</span>
          <select name="service">
            {enquiryOptions.map(([label]) => <option value={label}>{label}</option>)}
          </select>
        </label>

        <label>
          <span>Budget</span>
          <select name="budget">
            {budgets.map((b) => <option value={b}>{b}</option>)}
          </select>
        </label>
      </div>

      <label class="full">
        <span>How did you hear about me?</span>
        <select name="heard-from">
          <option value="">Please choose</option>
          {heardFrom.map((h) => <option value={h}>{h}</option>)}
        </select>
      </label>

      <label class="full">
        <span>What are you planning? <i>*</i></span>
        <textarea name="message" rows="6" required
          placeholder="The occasion, the kind of food you had in mind, anything your guests can't eat."></textarea>
      </label>

      {/* Honeypot: hidden from users, bots fill it. Checked in worker/index.js. */}
      <input class="hp" name="company-website" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" />

      <div class="actions">
        <button class="btn btn-primary" type="submit">Send enquiry</button>
        <p id="contact-status" role="status" aria-live="polite"></p>
      </div>
    </form>

    <p class="direct">
      Prefer to talk? Call <a href="tel:+16046266527">604 626 6527</a> or email
      <a href="mailto:jan@wcculinary.com">jan@wcculinary.com</a>.
    </p>
  </section>
</Base>

<script>
  import { attribution } from '../scripts/attribution.js';

  const form = document.getElementById('contact-form') as HTMLFormElement;
  const status = document.getElementById('contact-status') as HTMLParagraphElement;
  const button = form.querySelector('button[type="submit"]') as HTMLButtonElement;

  const slugs: Record<string, string> = JSON.parse(form.dataset.slugs || '{}');
  const base = form.dataset.base || '';

  // Prefill the service when a service page links here with ?service=…
  const wanted = new URLSearchParams(location.search).get('service');
  if (wanted) {
    const select = form.elements.namedItem('service') as HTMLSelectElement | null;
    const match = select && [...select.options].find((o) => o.value.toLowerCase() === wanted.toLowerCase());
    if (select && match) select.value = match.value;
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    button.disabled = true;
    status.textContent = 'Sending…';
    status.className = '';

    try {
      // Relative, so this works at the site root AND under a base path.
      const res = await fetch('api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          ...Object.fromEntries(new FormData(form)),
          ...attribution(),
        }),
      });
      const data = await res.json();
      if (data.ok) {
        const service = (form.elements.namedItem('service') as HTMLSelectElement).value;
        // replace, not assign: the form drops out of history, so Back returns
        // to the page they came from instead of a filled form they could
        // resubmit — which would double both the enquiry and the conversion.
        location.replace(`${base}/contact/thank-you/${slugs[service] || 'not-sure'}`);
      } else {
        status.textContent = data.error || 'Something went wrong. Please try again.';
        status.className = 'err';
        button.disabled = false;
      }
    } catch {
      status.textContent = 'Something went wrong. Please try again.';
      status.className = 'err';
      button.disabled = false;
    }
  });
</script>

<style>
  .form-section { padding: calc(96px * var(--section-gap)) 0 calc(120px * var(--section-gap)); }

  form { max-width: 780px; }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 26px 32px;
  }

  label { display: grid; gap: 9px; }
  label.full { margin-top: 26px; }

  label span {
    font-size: 0.625rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-neutral-500);
  }
  label i { color: var(--color-accent-300); font-style: normal; }

  input, select, textarea {
    width: 100%;
    background: var(--color-surface);
    border: 1px solid var(--color-divider);
    border-radius: var(--radius-md);
    padding: 13px 15px;
    color: var(--color-text);
    font-family: inherit;
    font-size: 0.9375rem;
  }
  textarea { resize: vertical; }
  input::placeholder, textarea::placeholder { color: var(--color-neutral-600); }
  input:focus, select:focus, textarea:focus { border-color: var(--color-accent); outline: none; }

  /* Native date/number controls render a dark-on-dark glyph otherwise. */
  input[type='date'] { color-scheme: dark; }

  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; }

  .direct { margin-top: 34px; font-size: 0.875rem; color: var(--color-neutral-400); }
  .direct a { color: var(--color-accent-300); border-bottom: 1px solid var(--color-accent-700); }

  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 24px; margin-top: 38px; }

  #contact-status { font-size: 0.875rem; color: var(--color-neutral-400); }
  #contact-status.ok { color: var(--color-accent-300); }
  #contact-status.err { color: #e2a0a0; }
</style>
