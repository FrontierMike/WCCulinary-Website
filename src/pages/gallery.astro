---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CTA from '../components/CTA.astro';
import photos from '../data/gallery';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base
  active="gallery"
  title="Gallery — West Coast Culinary Creations"
  description="Plated courses, grazing boards and event food cooked by Red Seal chef Janet Wait across South Surrey, White Rock and the Lower Mainland."
>
  <PageHero
    heading="Gallery"
    photo="gal-grazing"
    alt="A grazing board of cured meats, cheeses and fruit"
    size="gallery"
    height="min(62vh, 560px)"
  />

  <div class="wrap">
    <div class="intro" data-reveal>
      <p class="body-copy">
        Every photograph here is Jan's own food, from real events — private dinners,
        weddings, office lunches and wine pairing dinners across the Lower Mainland.
      </p>
      <a class="link-accent" href={`${base}/contact`.replace(/\/+/g, '/')}>Enquire about a date →</a>
    </div>

    {/* No lightbox — clicking a tile does nothing, by request. */}
    <div class="grid" data-reveal-stagger="80">
      {photos.map((photo) => (
        <figure data-reveal>
          <Image
            src={photo.src}
            alt={photo.alt}
            widths={[480]}
            sizes="(max-width: 700px) 45vw, 218px"
            loading="lazy"
            decoding="async"
          />
        </figure>
      ))}
    </div>
  </div>

  <CTA
    kicker="Booking"
    heading="Something here you want on your table?"
    body="Tell Jan the date, the number of people and roughly what you had in mind. She answers her own enquiries and quotes in writing before anything is booked."
  />
</Base>

<style>
  .intro {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 32px;
    padding: 72px 0 40px;
    border-bottom: 1px solid var(--color-divider);
  }
  .intro .body-copy { max-width: 56ch; }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(218px, 1fr));
    gap: 10px;
    padding: 40px 0 112px;
  }

  figure { margin: 0; overflow: hidden; border-radius: 3px; }

  figure :global(img) {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    transition: transform .9s var(--ease);
  }
  figure:hover :global(img) { transform: scale(1.06); }

  @media (max-width: 700px) {
    .grid { grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); }
  }
</style>
