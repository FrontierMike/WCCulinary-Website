---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { img } from '../data/images';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (p: string) => `${base}/${p}`.replace(/\/+/g, '/');

// The four quotes on this page (three below, one in the reviews row) are
// deliberately EXCERPTS, not the full reviews: one sharp line each, on the
// three blocks where the buying decision needs the most reassurance. The full
// versions live on the reviews page in src/data/reviews.ts — pull the single
// best sentence out of a new review for here, and keep the caption identical
// so the two pages agree.
const features = [
  {
    kicker: 'Weddings',
    heading: 'Intimate weddings, up to seventy-five guests',
    body: 'One menu consultation, and I am the chef on the day — not a name on the contract. Seventy-five guests is the ceiling on purpose: past that, the food stops being cooked and starts being reheated.',
    link: ['See how weddings work →', 'weddings'],
    slot: 'svc-weddings',
    alt: 'A chocolate pâté dessert plated for a wedding dinner',
    quote: 'The salmon was done to perfection, the tomato and bocconcini and the pasta and roasted vegetables were amazing!!',
    attribution: 'Small wedding at a local winery',
  },
  {
    kicker: 'Private dining',
    heading: 'Two to thirty-two people, in your own kitchen',
    body: 'I shop, arrive with my own knives and pans, cook each course, serve it, and leave the kitchen the way I found it. All you do is sit down. It is the easiest way to try my food, and the way most clients meet me before booking something larger.',
    link: ['How private dining works →', 'private-dining'],
    slot: 'private-dining-tacos',
    alt: 'A plated course from a private dinner',
    quote: 'You and your server, Persayis went above and beyond! Everyone loved her too!',
    attribution: 'Evening celebration · S & L',
  },
  {
    kicker: 'The food',
    heading: 'Main dishes made from scratch, with what is currently in season',
    body: 'Every main dish is cooked from raw ingredients, with nearly all the stocks, sauces, dressings and cures made from scratch. Menus are written to the season and to the coast — local seafood, produce from the valley — then adjusted to what you like and what your guests can eat.',
    link: ['See example menus →', 'menus'],
    slot: 'plating',
    alt: 'Seared scallops on a herb purée and red pepper sauce, finished with crisp cured ham',
    // The scallop plate is shot upright on a 520px-wide phone frame. A 4:3 box
    // crops it to the middle two scallops; 4:5 fits the whole plate.
    ratio: '4 / 5',
    // Both sentences stay — the first is the context that makes the second land.
    quote: "We truly appreciate all the effort you're putting into creating lovely meals, accommodating dietary needs and keeping everyone safe and well fed.",
    attribution: 'Two days of gluten-free catering, memorial · C & Family',
  },
  {
    kicker: 'Corporate',
    heading: "Office lunches and board dinners that don't taste like catering",
    body: 'Fixed delivery windows, plain per-head pricing, invoicing and standing accounts for repeat clients. Once I know your office, booking a lunch takes one email.',
    link: ['Corporate catering →', 'corporate'],
    slot: 'svc-corporate',
    alt: 'A buffet line of chafing dishes at an office lunch',
  },
  {
    kicker: 'The chef',
    heading: 'Twelve years running my own restaurant, now bringing that cooking to your event',
    body: "I am Red Seal certified, and my restaurant — Jan's on the Beach in White Rock — was an award-winning gourmet bistro for twelve years. Everything I serve is cooked by me, either in my commissary kitchen or on your own stove. No chef turns up on the day whom you have not already met.",
    link: ['Read my story →', 'about'],
    slot: 'jan-whites',
    alt: "Chef Janet Wait in her chef's whites outside Jan's on the Beach",
  },
];

// The four services that are not one of the five blocks above.
const everythingElse = [
  ['Celebrations', 'Milestone birthdays, anniversaries and parties, at home or at a venue — drop-off through to full service.', 'celebrations'],
  ['Wine pairing dinners', 'Bring out the bottles you have been saving and I write the courses around them.', 'wine-dinners'],
  ['Gluten-free catering', 'Menus written as gluten-free dishes in their own right, not substitutions, with separate boards and pans.', 'gluten-free-catering'],
  ['Gluten-free consulting', 'For restaurants and kitchens — menu review, kitchen handling and a written protocol your staff will follow.', 'gluten-free-consulting'],
];

// Ten plates, two rows of five. Narrow screens drop to two rows of three.
const strip = [
  ['gal-lamb', 'Rack of lamb, carved and plated with jus'],
  ['gal-shrimp', 'Prawns plated with a bright herb sauce'],
  ['gal-grazing', 'A grazing board of cured meats, cheeses and fruit'],
  ['gal-torte', 'A chocolate torte finished with cream'],
  ['gal-salad', 'A composed salad with edible flowers'],
  ['gal-salmon', 'Salmon served on a seafood risotto'],
  ['gal-clams', 'Clams steamed in their broth'],
  ['gal-braised', 'A braised main course plated with vegetables'],
  ['gal-crostini', 'Crostini topped and plated for a canape service'],
  ['gal-pate', 'A chocolate pate, sliced and plated'],
];
---
<Base>
  <!-- Hero -->
  <section class="hero">
    <Image
      src={img('hero-service')}
      alt="Chef Janet Wait finishing a line of plated courses during service"
      widths={[900, 1400, 1900]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="scrim-lr"></div>
    <div class="scrim-bt"></div>
    <div class="hero-content hero-rise">
      <p class="kicker">Boutique private chef &amp; catering · From South Surrey and White Rock to the Lower Mainland</p>
      <h1>Twelve years running an award-winning restaurant. Now cooking at your table.</h1>
      <p class="lead">
        I am Janet Wait, a Red Seal certified chef, and I still cook to a restaurant
        standard — everything from scratch, the same suppliers and the same passion I
        had at my own place, Jan's on the Beach. Cooked by me, in your kitchen or at
        your venue, for a handful of events each year.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={href('contact')}>Enquire about a date</a>
        <a class="btn btn-secondary" href={href('gallery')}>See the food</a>
      </div>
    </div>
  </section>

  <div class="wrap">
    <!-- Five alternating feature blocks -->
    {features.map((f, i) => (
      <section class:list={['feature', { flip: i % 2 === 1, first: i === 0 }]} data-reveal>
        <div class="feature-img" style={f.ratio && `--img-ratio: ${f.ratio}`}>
          <Image src={img(f.slot)} alt={f.alt} widths={[520, 800]} sizes="(max-width: 900px) 100vw, 50vw" />
        </div>
        <div>
          <p class="kicker">{f.kicker}</p>
          <h3>{f.heading}</h3>
          <p class="body-copy">{f.body}</p>
          {f.quote && (
            <div class="woven">
              <span class="mark"></span>
              <p class="quote">{f.quote}</p>
              <a class="attribution" href={href('reviews')}>{f.attribution} →</a>
            </div>
          )}
          <a class="link-accent" href={href(f.link[1])}>{f.link[0]}</a>
        </div>
      </section>
    ))}

    <!-- Reviews row — the sixth quote -->
    <section class="reviews-row divider-top" data-reveal>
      <p class="reviews-line">More reviews, in their own words.</p>
      <div class="woven reviews-quote">
        <span class="mark"></span>
        <p class="quote">
          We are incredibly grateful for the care, effort and thoughtfulness you
          showed. The food was delicious.
        </p>
        <a class="attribution" href={href('reviews')}>School parent Christmas party · E &amp; S →</a>
      </div>
      <a class="btn btn-secondary push-right" href={href('reviews')}>Read all reviews →</a>
    </section>

    <!-- Everything else -->
    <section class="everything divider-top" data-reveal>
      <div class="everything-head">
        <div>
          <p class="kicker">Everything else</p>
          <h2>Four more ways I cook</h2>
        </div>
        <a class="btn btn-secondary push-right" href={href('services')}>See all the ways I cook →</a>
      </div>
      {everythingElse.map(([title, desc, path]) => (
        <a class="svc-row" href={href(path)}>
          <h3>{title}</h3>
          <p>{desc}</p>
          <span class="learn">Learn more →</span>
        </a>
      ))}
    </section>

    <!-- Recent plates -->
    <section class="plates">
      <div class="plates-head" data-reveal>
        <h2>Recent plates</h2>
        <a class="btn btn-secondary push-right" href={href('gallery')}>View the full gallery →</a>
      </div>
      <div class="strip" data-reveal-stagger="80">
        {strip.map(([slot, alt]) => (
          <a href={href('gallery')} data-reveal>
            <Image src={img(slot)} alt={alt} widths={[260, 420]} sizes="20vw" loading="lazy" />
          </a>
        ))}
      </div>
    </section>
  </div>

  <!-- Closing call to action -->
  <section class="closing">
    <Image
      src={img('jan-plating')}
      alt="Jan in the kitchen, finishing a plate"
      widths={[900, 1400, 1900]}
      sizes="100vw"
      loading="lazy"
    />
    <div class="scrim-lr"></div>
    <div class="closing-content" data-reveal>
      <p class="kicker">A small number of events a year</p>
      <h2>Tell me the date and we will decide together what I will cook.</h2>
      <p class="body-copy closing-body">
        I answer every enquiry myself, with a written quote before anything is booked.
        Two to three weeks' notice for a dinner; two to three months for a wedding.
      </p>
      <a class="btn btn-primary" href={href('contact')}>Request a quote</a>
    </div>
  </section>
</Base>

<style>
  /* --- Hero --- */
  .hero {
    position: relative;
    min-height: min(94vh, 880px);
    display: flex;
    align-items: flex-end;
  }
  .hero :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 46%;
  }

  .hero-content {
    position: relative;
    width: 100%;
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 160px var(--page-pad) 96px;
  }

  .hero h1 {
    margin: 22px 0 26px;
    max-width: 17ch;
    font-size: clamp(42px, 6.2vw, 88px);
    line-height: 1.02;
    letter-spacing: 0.002em;
  }

  .hero-actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 38px; }

  /* space-between only right-aligns the last item while both children share a
     line; once the button wraps to its own row it falls back to flex-start.
     margin-left: auto holds the right edge at every width. */
  .push-right { margin-left: auto; }

  /* --- Feature blocks --- */
  .feature {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: clamp(32px, 5vw, 80px);
    align-items: center;
    padding: 96px 0;
    border-top: 1px solid var(--color-divider);
  }
  .feature.first { border-top: 0; }

  .feature-img :global(img) {
    width: 100%;
    aspect-ratio: var(--img-ratio, 4 / 3);
    object-fit: cover;
    border-radius: var(--radius-lg);
  }

  /* Blocks 2 and 4 put the image on the right. */
  .feature.flip .feature-img { order: 2; }

  .feature h3 {
    margin: 18px 0 20px;
    max-width: 22ch;
    font-size: clamp(28px, 3.2vw, 42px);
    line-height: 1.1;
  }
  .feature .link-accent { margin-top: 26px; }

  /* --- Woven review quote ---
     Nocturne's short accent mark, deliberately not a card, not a left border
     and not a quotation glyph. Attribution always links through to Reviews. */
  .woven {
    margin-top: 30px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    max-width: 46ch;
  }
  .mark { flex: none; width: 28px; height: 2px; background: var(--color-accent); }

  .quote {
    font-family: var(--font-serif);
    font-style: italic; /* the only italic in the system — it marks a different voice */
    font-size: 1.2188rem;
    line-height: 1.48;
    color: var(--color-neutral-200);
  }

  .attribution {
    font-size: 0.7813rem;
    color: var(--color-neutral-500);
    transition: color .25s var(--ease);
  }
  .attribution:hover { color: var(--color-accent-300); }

  .feature .woven { margin-bottom: 4px; }

  /* --- Reviews row --- */
  .reviews-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 36px;
    padding: 44px 0 56px;
  }
  .reviews-line {
    max-width: 20ch;
    font-family: var(--font-serif);
    font-size: clamp(24px, 2.8vw, 34px);
    line-height: 1.28;
  }
  .reviews-quote { margin-top: 0; max-width: 36ch; }

  /* --- Everything else --- */
  .everything { padding: 44px 0 112px; }

  .everything-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 28px;
    margin-bottom: 40px;
  }
  .everything-head h2 {
    margin-top: 16px;
    max-width: 20ch;
    font-size: clamp(28px, 3.4vw, 44px);
    line-height: 1.08;
  }

  /* Title, description and "Learn more" must be *direct* grid children. An
     earlier version wrapped the first two in a flex span and every description
     started wherever its title happened to end. */
  .svc-row {
    display: grid;
    grid-template-columns: minmax(190px, 230px) minmax(0, 1fr) auto;
    gap: 8px 28px;
    align-items: baseline;
    padding: 22px 0;
    border-top: 1px solid var(--color-divider);
    transition: opacity .25s var(--ease);
  }
  .svc-row:last-child { border-bottom: 1px solid var(--color-divider); }
  .svc-row:hover { opacity: 0.8; }

  .svc-row h3 { font-size: clamp(21px, 2.3vw, 28px); line-height: 1.14; }
  .svc-row p { font-size: 0.9375rem; line-height: 1.6; color: var(--color-neutral-400); }
  .learn {
    font-size: 0.7188rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-accent-300);
    white-space: nowrap;
  }

  /* The site's only media query. Two of the three columns are effectively
     fixed (190px floor + a nowrap link) and together need ~360px inside a
     326px phone viewport. Grid does not wrap, so the middle column absorbed
     the whole shortfall, went to 0px wide and rendered one character per line.
     Raising its floor does not help — only collapsing to one column does. */
  @media (max-width: 720px) {
    .svc-row { grid-template-columns: 1fr; gap: 6px; }
  }

  /* --- Recent plates --- */
  .plates { padding: 16px 0 112px; }

  .plates-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 36px;
    margin-bottom: 40px;
  }
  .plates-head h2 { font-size: clamp(32px, 4.4vw, 58px); line-height: 1.05; }

  /* minmax(0, …) matters — a pixel floor here overflowed the row and clipped
     the fifth photo at laptop widths. */
  .strip { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 10px; }

  .strip a { overflow: hidden; border-radius: var(--radius-sm); }
  .strip :global(img) {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    transition: transform .8s var(--ease);
  }
  .strip a:hover :global(img) { transform: scale(1.05); }

  /* Five tracks is too narrow on a phone. */
  @media (max-width: 600px) {
    .strip { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .strip a:nth-child(n + 7) { display: none; }
  }

  /* --- Closing --- */
  .closing { position: relative; }
  .closing :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
  }

  .closing-content {
    position: relative;
    max-width: var(--page-max);
    margin: 0 auto;
    padding: clamp(96px, 12vw, 168px) var(--page-pad);
  }
  .closing h2 {
    margin: 20px 0 24px;
    max-width: 20ch;
    font-size: clamp(32px, 4.4vw, 58px);
    line-height: 1.05;
  }
  .closing-body { max-width: 48ch; }
  .closing .btn { margin-top: 36px; }
</style>
