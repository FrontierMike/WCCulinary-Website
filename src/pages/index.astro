---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { img } from '../data/images';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (p: string) => `${base}/${p}`.replace(/\/+/g, '/');

// PLACEHOLDER REVIEWS. Every quote on this page is drafted copy, not a real
// customer. They read as specific and plausible, which is exactly what makes
// them dangerous to ship — replace all six with real reviews before launch.
const features = [
  {
    kicker: 'The chef',
    heading: 'A Red Seal chef who still cooks every plate herself',
    body: "Jan trained to the Red Seal standard and spent twelve years as owner and chef of Jan's on the Beach in White Rock. Everything she serves now comes off her own stove. There is no second kitchen, no roster of subcontractors, and no chef you haven't met turning up on the day.",
    link: ["Read Jan's story →", 'about'],
    slot: 'jan-whites',
    alt: "Chef Janet Wait in her chef's whites outside Jan's on the Beach",
    quote: 'She talked us out of the menu we asked for and into a better one, and she was right. That is worth more than being agreeable.',
    attribution: 'Wedding, forty guests · Langley',
  },
  {
    kicker: 'The food',
    heading: 'Made from scratch, from what is actually in season',
    body: 'Stocks, sauces, breads, pastry and cures are made in-house from raw ingredients. Menus are written to the season and to the coast — local seafood, produce from the valley — then adjusted to what you like and what your guests can eat.',
    link: ['See example menus →', 'menus'],
    slot: 'plating',
    alt: 'Plating a course by hand, garnishing with fresh herbs',
    quote: 'My daughter has coeliac disease. It is the first catered dinner where I did not have to watch her plate all night.',
    attribution: 'Fiftieth birthday · Ocean Park',
  },
  {
    kicker: 'Private dining',
    heading: 'Two to thirty people, in your own kitchen',
    body: 'Jan shops, arrives with her own knives and pans, cooks each course, serves it, and leaves the kitchen the way she found it. All you do is sit down. It is the easiest way to try her food, and the way most clients meet her before booking something larger.',
    link: ['How private dining works →', 'private-dining'],
    slot: 'private-dining-tacos',
    alt: 'A plated course from a private dinner',
    quote: 'The kitchen was cleaner when she left than when she arrived. I keep telling people that and they keep not believing me.',
    attribution: 'Private dinner for ten · South Surrey',
  },
  {
    kicker: 'Weddings',
    heading: 'Intimate weddings, under fifty guests',
    body: 'One menu consultation, one tasting, and Jan is the chef on the day — not a name on the contract. Fifty guests is the ceiling on purpose: past that, the food stops being cooked and starts being reheated.',
    link: ['See how weddings work →', 'weddings'],
    slot: 'svc-weddings',
    alt: 'A plated seafood course served at a wedding dinner',
    quote: 'She fed sixty people in a hall with no real kitchen and it came out like a restaurant. Two guests asked for her card before dessert.',
    attribution: 'Wedding, sixty guests · Crescent Beach',
  },
  {
    kicker: 'Corporate',
    heading: "Office lunches and board dinners that don't taste like catering",
    body: 'Fixed delivery windows, plain per-head pricing, invoicing and standing accounts for repeat clients. Once Jan knows your office, booking a lunch takes one email.',
    link: ['Corporate catering →', 'corporate'],
    slot: 'svc-corporate',
    alt: 'A plated main course prepared for a corporate dinner',
    quote: 'We book her for the same client dinner every quarter now. It arrives when she says it will and there has never been a correction to the invoice.',
    attribution: 'Corporate client dinner · South Surrey',
  },
];

// The four services that are not one of the five blocks above.
const everythingElse = [
  ['Celebrations', 'Milestone birthdays, anniversaries and parties, at home or at a venue — drop-off through to full service.', 'celebrations'],
  ['Wine pairing dinners', 'Bring out the bottles you have been saving and Jan writes the courses around them.', 'wine-dinners'],
  ['Gluten-free catering', 'Menus written as gluten-free dishes in their own right, not substitutions, with separate boards and pans.', 'gluten-free-catering'],
  ['Gluten-free consulting', 'For restaurants and kitchens — menu review, kitchen handling and a written protocol your staff will follow.', 'gluten-free-consulting'],
];

const strip = [
  ['gal-lamb', 'Rack of lamb, carved and plated with jus'],
  ['gal-shrimp', 'Prawns plated with a bright herb sauce'],
  ['gal-grazing', 'A grazing board of cured meats, cheeses and fruit'],
  ['gal-torte', 'A chocolate torte finished with cream'],
  ['gal-salad', 'A composed salad with edible flowers'],
];
---
<Base>
  <!-- Hero -->
  <section class="hero">
    <Image
      src={img('hero-service')}
      alt="Chef Janet Wait finishing a line of plated courses during service"
      widths={[900, 1400, 1900]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="scrim-lr"></div>
    <div class="scrim-bt"></div>
    <div class="hero-content hero-rise">
      <p class="kicker">Private chef &amp; catering · From South Surrey and White Rock to the Lower Mainland</p>
      <h1>Twelve years running a restaurant. Now cooking at your table.</h1>
      <p class="lead">
        Janet Wait is a Red Seal chef and, for twelve years, was the owner of an
        award-winning restaurant in White Rock. She isn't a catering company — she's
        one chef, cooking restaurant food in your kitchen or your venue, for a small
        number of events a year.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={href('contact')}>Enquire about a date</a>
        <a class="btn btn-secondary" href={href('gallery')}>See the food</a>
      </div>
    </div>
  </section>

  <div class="wrap">
    <!-- Five alternating feature blocks -->
    {features.map((f, i) => (
      <section class:list={['feature', { flip: i % 2 === 1, first: i === 0 }]} data-reveal>
        <div class="feature-img">
          <Image src={img(f.slot)} alt={f.alt} widths={[520, 800]} sizes="(max-width: 900px) 100vw, 50vw" />
        </div>
        <div>
          <p class="kicker">{f.kicker}</p>
          <h3>{f.heading}</h3>
          <p class="body-copy">{f.body}</p>
          <div class="woven">
            <span class="mark"></span>
            <p class="quote">{f.quote}</p>
            <a class="attribution" href={href('reviews')}>{f.attribution} →</a>
          </div>
          <a class="link-accent" href={href(f.link[1])}>{f.link[0]}</a>
        </div>
      </section>
    ))}

    <!-- Reviews row — the sixth quote -->
    <section class="reviews-row divider-top" data-reveal>
      <p class="reviews-line">More reviews, in their own words.</p>
      <div class="woven reviews-quote">
        <span class="mark"></span>
        <p class="quote">
          Eight of us at our own table, four courses, and my wife did not stand up
          once all evening. That was the actual gift.
        </p>
        <a class="attribution" href={href('reviews')}>Anniversary dinner at home · White Rock →</a>
      </div>
      <a class="btn btn-secondary push-right" href={href('reviews')}>Read all reviews →</a>
    </section>

    <!-- Everything else -->
    <section class="everything divider-top" data-reveal>
      <div class="everything-head">
        <div>
          <p class="kicker">Everything else</p>
          <h2>Four more ways Jan cooks</h2>
        </div>
        <a class="btn btn-secondary push-right" href={href('services')}>See all the ways I cook →</a>
      </div>
      {everythingElse.map(([title, desc, path]) => (
        <a class="svc-row" href={href(path)}>
          <h3>{title}</h3>
          <p>{desc}</p>
          <span class="learn">Learn more →</span>
        </a>
      ))}
    </section>

    <!-- Recent plates -->
    <section class="plates">
      <div class="plates-head" data-reveal>
        <h2>Recent plates</h2>
        <a class="btn btn-secondary push-right" href={href('gallery')}>View the full gallery →</a>
      </div>
      <div class="strip" data-reveal-stagger="80">
        {strip.map(([slot, alt]) => (
          <a href={href('gallery')} data-reveal>
            <Image src={img(slot)} alt={alt} widths={[260, 420]} sizes="20vw" loading="lazy" />
          </a>
        ))}
      </div>
    </section>
  </div>

  <!-- Closing call to action -->
  <section class="closing">
    <Image
      src={img('jan-plating')}
      alt="Jan in the kitchen, finishing a plate"
      widths={[900, 1400, 1900]}
      sizes="100vw"
      loading="lazy"
    />
    <div class="scrim-lr"></div>
    <div class="closing-content" data-reveal>
      <p class="kicker">A small number of events a year</p>
      <h2>Tell Jan the date and she will work with you to decide what she will cook.</h2>
      <p class="body-copy closing-body">
        Every enquiry is answered by Jan herself, with a written quote before anything
        is booked. Two to three weeks' notice for a dinner; two to three months for a wedding.
      </p>
      <a class="btn btn-primary" href={href('contact')}>Request a quote</a>
    </div>
  </section>
</Base>

<style>
  /* --- Hero --- */
  .hero {
    position: relative;
    min-height: min(94vh, 880px);
    display: flex;
    align-items: flex-end;
  }
  .hero :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 46%;
  }

  .hero-content {
    position: relative;
    width: 100%;
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 160px var(--page-pad) 96px;
  }

  .hero h1 {
    margin: 22px 0 26px;
    max-width: 17ch;
    font-size: clamp(42px, 6.2vw, 88px);
    line-height: 1.02;
    letter-spacing: 0.002em;
  }

  .hero-actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 38px; }

  /* space-between only right-aligns the last item while both children share a
     line; once the button wraps to its own row it falls back to flex-start.
     margin-left: auto holds the right edge at every width. */
  .push-right { margin-left: auto; }

  /* --- Feature blocks --- */
  .feature {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: clamp(32px, 5vw, 80px);
    align-items: center;
    padding: 96px 0;
    border-top: 1px solid var(--color-divider);
  }
  .feature.first { border-top: 0; }

  .feature-img :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }

  /* Blocks 2 and 4 put the image on the right. */
  .feature.flip .feature-img { order: 2; }

  .feature h3 {
    margin: 18px 0 20px;
    max-width: 22ch;
    font-size: clamp(28px, 3.2vw, 42px);
    line-height: 1.1;
  }
  .feature .link-accent { margin-top: 26px; }

  /* --- Woven review quote ---
     Nocturne's short accent mark, deliberately not a card, not a left border
     and not a quotation glyph. Attribution always links through to Reviews. */
  .woven {
    margin-top: 30px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    max-width: 46ch;
  }
  .mark { flex: none; width: 28px; height: 2px; background: var(--color-accent); }

  .quote {
    font-family: var(--font-serif);
    font-style: italic; /* the only italic in the system — it marks a different voice */
    font-size: 19.5px;
    line-height: 1.48;
    color: var(--color-neutral-200);
  }

  .attribution {
    font-size: 12.5px;
    color: var(--color-neutral-500);
    transition: color .25s var(--ease);
  }
  .attribution:hover { color: var(--color-accent-300); }

  .feature .woven { margin-bottom: 4px; }

  /* --- Reviews row --- */
  .reviews-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 36px;
    padding: 44px 0 56px;
  }
  .reviews-line {
    max-width: 20ch;
    font-family: var(--font-serif);
    font-size: clamp(24px, 2.8vw, 34px);
    line-height: 1.28;
  }
  .reviews-quote { margin-top: 0; max-width: 36ch; }

  /* --- Everything else --- */
  .everything { padding: 44px 0 112px; }

  .everything-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 28px;
    margin-bottom: 40px;
  }
  .everything-head h2 {
    margin-top: 16px;
    max-width: 20ch;
    font-size: clamp(28px, 3.4vw, 44px);
    line-height: 1.08;
  }

  /* Title, description and "Learn more" must be *direct* grid children. An
     earlier version wrapped the first two in a flex span and every description
     started wherever its title happened to end. */
  .svc-row {
    display: grid;
    grid-template-columns: minmax(190px, 230px) minmax(0, 1fr) auto;
    gap: 8px 28px;
    align-items: baseline;
    padding: 22px 0;
    border-top: 1px solid var(--color-divider);
    transition: opacity .25s var(--ease);
  }
  .svc-row:last-child { border-bottom: 1px solid var(--color-divider); }
  .svc-row:hover { opacity: 0.8; }

  .svc-row h3 { font-size: clamp(21px, 2.3vw, 28px); line-height: 1.14; }
  .svc-row p { font-size: 15px; line-height: 1.6; color: var(--color-neutral-400); }
  .learn {
    font-size: 11.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-accent-300);
    white-space: nowrap;
  }

  /* The site's only media query. Two of the three columns are effectively
     fixed (190px floor + a nowrap link) and together need ~360px inside a
     326px phone viewport. Grid does not wrap, so the middle column absorbed
     the whole shortfall, went to 0px wide and rendered one character per line.
     Raising its floor does not help — only collapsing to one column does. */
  @media (max-width: 720px) {
    .svc-row { grid-template-columns: 1fr; gap: 6px; }
  }

  /* --- Recent plates --- */
  .plates { padding: 16px 0 112px; }

  .plates-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 36px;
    margin-bottom: 40px;
  }
  .plates-head h2 { font-size: clamp(32px, 4.4vw, 58px); line-height: 1.05; }

  /* minmax(0, …) matters — a pixel floor here overflowed the row and clipped
     the fifth photo at laptop widths. */
  .strip { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 10px; }

  .strip a { overflow: hidden; border-radius: var(--radius-sm); }
  .strip :global(img) {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    transition: transform .8s var(--ease);
  }
  .strip a:hover :global(img) { transform: scale(1.05); }

  /* Five tracks is too narrow on a phone. */
  @media (max-width: 600px) {
    .strip { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .strip a:nth-child(n + 4) { display: none; }
  }

  /* --- Closing --- */
  .closing { position: relative; }
  .closing :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
  }

  .closing-content {
    position: relative;
    max-width: var(--page-max);
    margin: 0 auto;
    padding: clamp(96px, 12vw, 168px) var(--page-pad);
  }
  .closing h2 {
    margin: 20px 0 24px;
    max-width: 20ch;
    font-size: clamp(32px, 4.4vw, 58px);
    line-height: 1.05;
  }
  .closing-body { max-width: 48ch; }
  .closing .btn { margin-top: 36px; }
</style>
