---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CTA from '../components/CTA.astro';
import { services } from '../data/services';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (p: string) => `${base}/${p}`.replace(/\/+/g, '/');

// ponytail: the sample menus already live on the service pages. Deriving them
// here keeps one copy of every dish name — edit a menu once, both pages change.
const groups = services
  .map((s) => ({
    slug: s.slug,
    title: s.title,
    menus: s.sections.flatMap((sec) => (sec.type === 'menus' ? sec.menus : [])),
  }))
  .filter((g) => g.menus.length > 0);
---
<Base
  active="menus"
  title="Example menus — West Coast Culinary Creations"
  description="Sample wedding, private dining, corporate, celebration, wine pairing and fully gluten-free menus cooked by Red Seal chef Janet Wait."
>
  <PageHero
    kicker="Example menus"
    heading="Every menu here has been cooked. Yours could be one of them."
    lead="Starting points, not a set list. Every menu is written around what is in season, what you like and what your guests can eat."
    photo="hero-menus"
    alt="Stuffed pepper halves and zucchini boats plated on white china"
    fit="contain"
  />

  <nav class="jump wrap" data-reveal>
    {groups.map((g) => <a href={`#${g.slug}`}>{g.title}</a>)}
  </nav>

  {groups.map((g) => (
    <section id={g.slug} class="group divider-top" data-reveal>
      <div class="wrap">
        <div class="head">
          <h2>{g.title}</h2>
          <a class="link-accent" href={href(g.slug)}>How {g.title.toLowerCase()} works →</a>
        </div>
        <div class="cards" data-reveal-stagger="70">
          {g.menus.map((m) => (
            <div class="card" data-reveal>
              <p class="tag">{m.tag}</p>
              <h3>{m.title}</h3>
              <ul>{m.items.map((i) => <li>{i}</li>)}</ul>
            </div>
          ))}
        </div>
      </div>
    </section>
  ))}

  <CTA
    kicker="Your menu"
    heading="Tell me what you like and I will write one for your table."
    body="A twenty-minute conversation is usually enough. I draft the menu around what is good that week and adjust it until it is right."
  />
</Base>

<style>
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding-top: 56px;
    padding-bottom: 56px;
  }
  .jump a {
    padding: 9px 16px;
    border: 1px solid var(--color-divider);
    border-radius: 100px;
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-neutral-400);
    transition: border-color .25s var(--ease), color .25s var(--ease);
  }
  .jump a:hover { border-color: var(--color-accent); color: var(--color-accent-300); }

  .group { padding: 88px 0; scroll-margin-top: 110px; }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 32px;
    margin-bottom: 44px;
  }
  .head h2 { font-size: clamp(30px, 3.6vw, 48px); line-height: 1.06; }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    /* Menus run from three courses to eleven lines — without this the short
       cards stretch to the tallest and sit half empty inside their border. */
    align-items: start;
    gap: 28px;
  }

  .card {
    padding: 30px 28px 32px;
    border: 1px solid var(--color-divider);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--color-surface) 55%, transparent);
  }

  .tag {
    font-size: 0.625rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-accent-300);
    margin-bottom: 10px;
  }
  .card h3 { font-size: 21px; line-height: 1.25; }

  .card ul { margin: 16px 0 0; padding: 0; list-style: none; display: grid; gap: 10px; }
  .card li {
    font-size: 0.9063rem;
    line-height: 1.55;
    color: var(--color-neutral-300);
    padding-left: 16px;
    position: relative;
  }
  .card li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 9px;
    width: 5px;
    height: 1px;
    background: var(--color-accent-700);
  }
</style>
