---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CTA from '../components/CTA.astro';
import { catering, restaurant, restaurantTotal } from '../data/reviews';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base
  active="reviews"
  title="Reviews — West Coast Culinary Creations"
  description="What clients say about Chef Janet Wait's catering and private dining across South Surrey, White Rock and the Lower Mainland."
>
  <PageHero
    kicker="Reviews"
    heading="Almost all of my work comes from repeat customers."
    lead="Twelve years of restaurant regulars, and now clients who book the same dinner every year. These are their words, not mine."
    photo="hero-reviews"
    alt="Cilantro scattered over stuffed poblanos finished with crema and pomegranate"
    {/* Square photo (1707x1707) in a full-bleed hero: `cover` scales it to the
        viewport width whatever the height is, so a short band crops it to a
        sliver. Taller, and pushed down the frame, keeps the hand and the
        finished plate in shot. */}
    height="min(76vh, 720px)"
    objectPosition="center 56%"
  />

  <section data-reveal>
    <div class="wrap ask">
      <div>
        <p class="kicker">Cooked for you before?</p>
        <h2>A few sentences does more than any advertising I could buy.</h2>
      </div>
      <div>
        <p class="body-copy">
          What you ate and how the night went. It takes two minutes and I read every one.
        </p>
        <div class="ask-actions">
          <a class="btn btn-primary" href={`${base}/contact`.replace(/\/+/g, '/')}>Send me a review</a>
          {/* Google's own write-a-review endpoint. The place id is just the two
              halves of the Maps feature id (0x1de33033abe7d4d, 0x9f6e24534b345600)
              packed little-endian and base64url'd — same listing as
              https://maps.google.com/?cid=11488159639631320576. Verified it
              resolves. Works while the profile is still unverified; signed-out
              visitors get a Google sign-in first, then the star box. */}
          <a class="btn btn-secondary" href="https://search.google.com/local/writereview?placeid=ChIJTX2-OgMz3gERAFY0S1Mkbp8" target="_blank" rel="noopener">Leave a Google review</a>
        </div>
      </div>
    </div>
  </section>

  <section class="divider-top">
    <div class="wrap archive-head" data-reveal>
      <div>
        <p class="kicker">Catering and private dining</p>
        <h2>Reviews from the work I do now:</h2>
      </div>
    </div>

    <div class="wrap cards catering-cards" data-reveal-stagger="80">
      {catering.map(([quote, who]) => (
        <figure data-reveal>
          <p class="stars" role="img" aria-label="Rated five out of five">★★★★★</p>
          <blockquote>{quote}</blockquote>
          <figcaption>{who}</figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="divider-top">
    <div class="wrap archive-head" data-reveal>
      <div>
        <p class="kicker">The restaurant years</p>
        <h2>Different room, same chef.</h2>
      </div>
      <div>
        <p class="body-copy">
          These were written about the restaurant, not the catering — same hands
          on the pans and the same suppliers, so I have kept them.
        </p>
        <p class="archive-count">{restaurant.length} of {restaurantTotal}</p>
      </div>
    </div>

    {/* Same scroll-reveal as the gallery grid. It primes every card on load
        with inline styles and one shared observer — fine at a hundred cards,
        worth reconsidering if this list ever runs to five hundred. */}
    <div class="wrap cards archive-cards" data-reveal-stagger="80">
      {restaurant.map(([quote, who]) => (
        <figure data-reveal>
          <p class="stars" role="img" aria-label="Rated five out of five">★★★★★</p>
          <blockquote>{quote}</blockquote>
          <figcaption>{who}</figcaption>
        </figure>
      ))}
    </div>
  </section>

  <CTA
    kicker="Planning something of your own?"
    heading="Tell me the date and roughly how many people."
    body="Two business days to a real answer, and a written quote before anything is booked."
  />
</Base>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 24px;
    padding: calc(88px * var(--section-gap)) 0 calc(104px * var(--section-gap));
  }

  figure {
    /* Grid stretches every card to the tallest in its row, which left short
       quotes stranded at the top. Centre the contents instead. */
    display: flex;
    flex-direction: column;
    justify-content: center;
    margin: 0;
    padding: 34px 32px 30px;
    border: 1px solid var(--color-divider);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--color-surface) 55%, transparent);
  }

  blockquote {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 22px;
    line-height: 1.34;
    color: var(--color-text);
  }

  figcaption {
    margin-top: 22px;
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-neutral-500);
  }

  .ask {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 56px;
    align-items: start;
    padding-top: calc(88px * var(--section-gap));
    padding-bottom: calc(96px * var(--section-gap));
  }
  .ask .kicker { margin-bottom: 18px; }
  .ask h2 { max-width: 18ch; font-size: clamp(30px, 3.4vw, 46px); line-height: 1.08; }
  .ask-actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 30px; }

  .archive-head {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 56px;
    align-items: start;
    padding-top: calc(88px * var(--section-gap));
  }
  .archive-head .kicker { margin-bottom: 18px; }
  .archive-head h2 {
    max-width: 18ch;
    font-size: clamp(28px, 3vw, 40px);
    line-height: 1.08;
  }

  .archive-count {
    margin-top: 22px;
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-neutral-500);
  }

  .archive-cards,
  .catering-cards { padding-top: calc(56px * var(--section-gap)); }

  /* ponytail: the restaurant list runs to several hundred cards, all on the
     page at once. This is what makes them cost nothing until you scroll to
     them — the browser skips layout and paint for the off-screen ones.
     contain-intrinsic-size is the reserved height guess that keeps the
     scrollbar honest; raise it if long quotes make the bar jump. */
  .archive-cards figure {
    content-visibility: auto;
    contain-intrinsic-size: auto 300px;
  }
</style>
