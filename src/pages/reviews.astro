---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CTA from '../components/CTA.astro';
import { catering, restaurant, restaurantTotal } from '../data/reviews';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base
  active="reviews"
  title="Reviews — West Coast Culinary Creations"
  description="What clients say about Chef Janet Wait's catering and private dining across South Surrey, White Rock and the Lower Mainland."
>
  <PageHero
    kicker="Reviews"
    heading="Almost all of my work comes from repeat customers."
    lead="Twelve years of restaurant regulars, and now clients who book the same dinner every year. These are their words, not mine."
    photo="svc-celebrations"
    alt="A table set for a celebration dinner"
  />

  <section data-reveal>
    <div class="wrap ask">
      <div>
        <p class="kicker">Cooked for you before?</p>
        <h2>A few sentences does more than any advertising I could buy.</h2>
      </div>
      <div>
        <p class="body-copy">
          What you ate and how the night went. It takes two minutes and I read every one.
        </p>
        <div class="ask-actions">
          <a class="btn btn-primary" href={`${base}/contact`.replace(/\/+/g, '/')}>Send me a review</a>
          {/* TODO: swap for the real Google Business Profile review link. */}
          <a class="btn btn-secondary" href={`${base}/contact`.replace(/\/+/g, '/')}>Leave a Google review</a>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap cards divider-top" data-reveal-stagger="80">
    {catering.map(([quote, who]) => (
      <figure data-reveal>
        <blockquote>{quote}</blockquote>
        <figcaption>{who}</figcaption>
      </figure>
    ))}
  </section>

  <section class="divider-top" data-reveal>
    <details class="wrap archive">
      <summary>
        <span>
          <span class="kicker">The restaurant years</span>
          <h2>Same chef, same kitchen, different room.</h2>
        </span>
        <span class="archive-count">{restaurant.length} of {restaurantTotal}</span>
      </summary>
      <p class="body-copy archive-note">
        These were written about the restaurant, not the catering — same hands on
        the pans and the same suppliers, so I have kept them.
      </p>
      <div class="cards archive-cards">
        {restaurant.map(([quote, who]) => (
          <figure>
            <blockquote>{quote}</blockquote>
            <figcaption>{who}</figcaption>
          </figure>
        ))}
      </div>
    </details>
  </section>

  <CTA
    kicker="Planning something of your own?"
    heading="Tell me the date and roughly how many people."
    body="Two business days to a real answer, and a written quote before anything is booked."
  />
</Base>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 24px;
    padding: 88px 0 104px;
  }

  figure {
    margin: 0;
    padding: 34px 32px 30px;
    border: 1px solid var(--color-divider);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--color-surface) 55%, transparent);
  }

  blockquote {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 22px;
    line-height: 1.34;
    color: var(--color-text);
  }

  figcaption {
    margin-top: 22px;
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-neutral-500);
  }

  .ask {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 56px;
    align-items: start;
    padding-top: 88px;
    padding-bottom: 96px;
  }
  .ask .kicker { margin-bottom: 18px; }
  .ask h2 { max-width: 18ch; font-size: clamp(30px, 3.4vw, 46px); line-height: 1.08; }
  .ask-actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 30px; }

  .archive { padding-top: 88px; padding-bottom: 104px; }

  .archive summary {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 32px;
    justify-content: space-between;
    align-items: baseline;
    cursor: pointer;
    list-style: none;
  }
  .archive summary::-webkit-details-marker { display: none; }
  .archive summary .kicker { display: block; margin-bottom: 18px; }
  .archive summary h2 {
    max-width: 18ch;
    font-size: clamp(28px, 3vw, 40px);
    line-height: 1.08;
  }

  .archive-count {
    font-size: 0.6875rem;
    line-height: 1.6;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-neutral-500);
    max-width: 26ch;
  }
  .archive-count::after { content: ' · show'; }
  .archive[open] .archive-count::after { content: ' · hide'; }

  .archive-note { margin-top: 26px; }
  .archive-cards { padding: 48px 0 0; }

  /* ponytail: the restaurant list runs to several hundred cards. Skipping
     layout and paint for the off-screen ones is two lines; swap for real
     pagination only if scrolling still stutters. */
  .archive-cards figure {
    content-visibility: auto;
    contain-intrinsic-size: auto 260px;
  }
</style>
