{
  // Cloudflare Worker config for the West Coast Culinary Creations site.
  // "name" MUST match the Worker project name in the Cloudflare dashboard.
  "name": "wcculinary-website",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-01",
  // Deploys into Jan's Cloudflare account, which holds the wcculinary.com
  // zone. The apex and www are the live site; preview stays for checking a
  // build before it goes out, and worker/index.js serves it noindex so it
  // never competes with the apex for its own copy.
  //
  // A custom_domain makes Cloudflare own that hostname's DNS record. The apex
  // and www still pointed at the WordPress host, so those records have to be
  // deleted in the dashboard before this deploys — see the cutover notes.
  "routes": [
    { "pattern": "wcculinary.com", "custom_domain": true },
    { "pattern": "www.wcculinary.com", "custom_domain": true },
    { "pattern": "preview.wcculinary.com", "custom_domain": true }
  ],
  "assets": {
    // Astro's static build output. `npm run build` produces this.
    "directory": "./dist",
    // Exposes env.ASSETS so the Worker can serve static files.
    "binding": "ASSETS",
    // Serve the branded 404 (src/pages/404.astro) for unmatched paths instead
    // of Cloudflare's bare default, which carries no nav to recover from.
    "not_found_handling": "404-page"
  }
}
